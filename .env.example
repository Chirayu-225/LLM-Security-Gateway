# Copy this file to .env and fill in real values. Never commit the real .env.

# Required: your Groq API key (https://console.groq.com)
GROQ_API_KEY=

# Required for /agent/check-tool-call, /redteam/run, and /stats.
# Generate one yourself, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
GATEWAY_API_KEY=
